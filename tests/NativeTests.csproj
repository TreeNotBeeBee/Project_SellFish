<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <AssemblyName>WindowPilot.NativeTests</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="NativeTests.cs" />
    <Compile Include="../NativeEffectOverlay.cs" Link="NativeEffectOverlay.cs" />
    <Compile Include="../BackdropOpacityLayer.cs" Link="BackdropOpacityLayer.cs" />
    <Compile Include="..\WindowService.cs" Link="WindowService.cs" />
  </ItemGroup>
</Project>
