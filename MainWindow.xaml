<Window
    x:Class="WindowPilot.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="sell fish">
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <Style x:Key="PanelCheckBox" TargetType="CheckBox">
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="Padding" Value="6,0,0,0"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Style>
            <Style x:Key="ShortcutField" TargetType="TextBox">
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="IsSpellCheckEnabled" Value="False"/>
                <Setter Property="IsTextPredictionEnabled" Value="False"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style x:Key="ClearShortcutButton" TargetType="Button">
                <Setter Property="Content" Value="⌫"/>
                <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Width" Value="28"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Padding" Value="0"/>
            </Style>
            <Style x:Key="CaptionButton" TargetType="Button">
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
            </Style>
        </Grid.Resources>
        <Grid x:Name="PanelContent" Margin="16,26,16,10" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <SelectorBar x:Name="Pages" HorizontalAlignment="Left" SelectionChanged="PageChanged"
                         AutomationProperties.Name="功能分页">
                <SelectorBarItem x:Name="BasicTab" Text="基础" IsSelected="True" AutomationProperties.AutomationId="BasicTab"/>
                <SelectorBarItem x:Name="AdvancedTab" Text="进阶" AutomationProperties.AutomationId="AdvancedTab"/>
                <SelectorBarItem x:Name="ShortcutsTab" Text="快捷键" AutomationProperties.AutomationId="ShortcutsTab"/>
                <SelectorBarItem x:Name="SettingsTab" Text="设置" AutomationProperties.AutomationId="SettingsTab"/>
            </SelectorBar>
        <Grid x:Name="BasicPage" Grid.Row="1" RowSpacing="9" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="TargetBox" HorizontalAlignment="Stretch" MinWidth="90" MaxDropDownHeight="340"
                          PlaceholderText="选择要绑定的窗口" DisplayMemberPath="Display"
                          AutomationProperties.AutomationId="TargetBox" AutomationProperties.Name="绑定窗口"
                          SelectionChanged="SelectTarget"/>
                <CheckBox x:Name="TopmostBox" Grid.Column="1" AutomationProperties.AutomationId="TopmostBox"
                          Style="{StaticResource PanelCheckBox}" Content="始终置顶" Click="ChangeTopmost"/>
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="不透明度" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="OpacityInput" Grid.Column="1" Width="72" Text="100" MaxLength="3" InputScope="Number"
                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="6,4"
                         IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                         AutomationProperties.AutomationId="OpacityInput" AutomationProperties.Name="不透明度百分比"
                         ToolTipService.ToolTip="输入 0 到 100，按 Enter 或离开输入框生效" LostFocus="CommitOpacity" KeyDown="OpacityInputKeyDown"/>
                <TextBlock Grid.Column="2" Text="%" Style="{StaticResource FieldLabel}"/>
                <Button x:Name="ZeroButton" Grid.Column="3" MinWidth="40" Padding="6,3" Content="0%"
                        AutomationProperties.AutomationId="ZeroButton" AutomationProperties.Name="切换全透明"
                        ToolTipService.ToolTip="切换到完全透明，再点一次恢复上次数值" Click="ToggleZero"/>
                <CheckBox x:Name="InvertBox" Grid.Column="5" Content="反色" Style="{StaticResource PanelCheckBox}"
                          AutomationProperties.AutomationId="InvertBox" Click="ChangeFilters"/>
                <CheckBox x:Name="GrayBox" Grid.Column="6" Content="灰度" Margin="6,0,0,0" Style="{StaticResource PanelCheckBox}"
                          AutomationProperties.AutomationId="GrayBox" Click="ChangeFilters"/>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="24">
                <CheckBox x:Name="HiddenBox" Content="隐藏" Style="{StaticResource PanelCheckBox}"
                          AutomationProperties.AutomationId="HiddenBox" Click="ToggleHidden"/>
                <CheckBox x:Name="ClickThroughBox" Content="页面穿透" Style="{StaticResource PanelCheckBox}"
                          ToolTipService.ToolTip="鼠标直接操作目标窗口下方的窗口"
                          AutomationProperties.AutomationId="ClickThroughBox" Click="ToggleClickThrough"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="ShortcutsPage" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Top"
              ColumnSpacing="8" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="隐藏" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="HideShortcutBox" Grid.Column="1" Style="{StaticResource ShortcutField}"
                         AutomationProperties.AutomationId="HideShortcutBox" AutomationProperties.Name="隐藏快捷键"/>
                <Button x:Name="HideShortcutClear" Grid.Column="2" Style="{StaticResource ClearShortcutButton}"
                        AutomationProperties.AutomationId="HideShortcutClear" AutomationProperties.Name="清除隐藏快捷键"/>
                <TextBlock Grid.Row="1" Text="页面穿透" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ThroughShortcutBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource ShortcutField}"
                         AutomationProperties.AutomationId="ThroughShortcutBox" AutomationProperties.Name="页面穿透快捷键"/>
                <Button x:Name="ThroughShortcutClear" Grid.Row="1" Grid.Column="2" Style="{StaticResource ClearShortcutButton}"
                        AutomationProperties.AutomationId="ThroughShortcutClear" AutomationProperties.Name="清除页面穿透快捷键"/>
                <TextBlock Grid.Row="2" Text="增加不透明度" Style="{StaticResource FieldLabel}" ToolTipService.ToolTip="每次增加 10 个百分点"/>
                <TextBox x:Name="OpacityUpShortcutBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource ShortcutField}"
                         AutomationProperties.AutomationId="OpacityUpShortcutBox" AutomationProperties.Name="增加不透明度快捷键"/>
                <Button x:Name="OpacityUpShortcutClear" Grid.Row="2" Grid.Column="2" Style="{StaticResource ClearShortcutButton}"
                        AutomationProperties.AutomationId="OpacityUpShortcutClear" AutomationProperties.Name="清除增加不透明度快捷键"/>
                <TextBlock Grid.Row="3" Text="减少不透明度" Style="{StaticResource FieldLabel}" ToolTipService.ToolTip="每次减少 10 个百分点"/>
                <TextBox x:Name="OpacityDownShortcutBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource ShortcutField}"
                         AutomationProperties.AutomationId="OpacityDownShortcutBox" AutomationProperties.Name="减少不透明度快捷键"/>
                <Button x:Name="OpacityDownShortcutClear" Grid.Row="3" Grid.Column="2" Style="{StaticResource ClearShortcutButton}"
                        AutomationProperties.AutomationId="OpacityDownShortcutClear" AutomationProperties.Name="清除减少不透明度快捷键"/>
        </Grid>
        <Grid x:Name="AdvancedPage" Grid.Row="1" Visibility="Collapsed" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="PickControl" Content="选择控件" Click="PickNativeControl"
                        AutomationProperties.AutomationId="PickControl"/>
                <Button x:Name="PickRegion" Content="选择输出区域" Click="PickOutputRegion"
                        AutomationProperties.AutomationId="PickRegion"/>
            </StackPanel>
            <TextBlock x:Name="AdvancedHint" Grid.Row="1" TextWrapping="Wrap"
                       Style="{ThemeResource CaptionTextBlockStyle}" AutomationProperties.AutomationId="AdvancedHint"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DetachedRows" Spacing="2" AutomationProperties.Name="已分离的组件"/>
            </ScrollViewer>
        </Grid>
        <Grid x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed">
            <StackPanel x:Name="SettingsOverview" Spacing="10">
                <CheckBox x:Name="ToolPin" Content="sell fish 始终置顶" Click="SetToolPin"
                          Style="{StaticResource PanelCheckBox}" AutomationProperties.AutomationId="ToolPin"
                          ToolTipService.ToolTip="同时应用于主面板、工具栏和所有分离浮窗"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="主题" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="ThemeBox" Width="70" AutomationProperties.AutomationId="ThemeBox" AutomationProperties.Name="主题">
                        <ComboBoxItem Content="白"/>
                        <ComboBoxItem Content="黑"/>
                    </ComboBox>
                    <TextBlock Text="工具栏样式" Margin="12,0,0,0" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="MiniStyleBox" Width="100" AutomationProperties.AutomationId="MiniStyleBox"
                              AutomationProperties.Name="工具栏样式">
                        <ComboBoxItem Content="初始"/>
                        <ComboBoxItem Content="输入法"/>
                    </ComboBox>
                    <Button x:Name="EditToolbarActions" Margin="4,0,0,0" Click="OpenToolbarSettings"
                            AutomationProperties.AutomationId="EditToolbarActions" AutomationProperties.Name="工具栏功能">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="工具栏功能"/>
                            <FontIcon FontSize="12" Glyph="&#xE76C;"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
            <Grid x:Name="ToolbarSettingsPage" Visibility="Collapsed" RowSpacing="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ToolbarSettingsBack" Click="CloseToolbarSettings" Padding="8,4"
                            AutomationProperties.AutomationId="ToolbarSettingsBack" AutomationProperties.Name="返回设置"
                            ToolTipService.ToolTip="返回设置">
                        <FontIcon FontSize="14" Glyph="&#xE72B;"/>
                    </Button>
                    <TextBlock Grid.Column="1" Text="工具栏功能" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ToolbarCount" Grid.Column="2" Style="{StaticResource FieldLabel}"
                               AutomationProperties.AutomationId="ToolbarCount"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="4">
                        <TextBlock Text="按勾选顺序显示，取消后重新勾选即可排到末尾。"
                                   Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Grid x:Name="ToolbarActionOptions" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                        <TextBlock x:Name="ToolbarOrder" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="ToolbarOrder" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
            <TextBlock x:Name="StatusText" Grid.Row="2" Visibility="Collapsed" TextWrapping="Wrap"
                       MaxLines="2" TextTrimming="CharacterEllipsis" Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       AutomationProperties.AutomationId="StatusText" AutomationProperties.LiveSetting="Polite"/>
        </Grid>
        <StackPanel x:Name="CaptionButtons" Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Margin="0,2,3,0">
            <Button x:Name="CollapseButton" Style="{StaticResource CaptionButton}"
                    AutomationProperties.AutomationId="CollapseButton" AutomationProperties.Name="收起为工具栏"
                    ToolTipService.ToolTip="收起为工具栏">
                <FontIcon FontSize="10" Glyph="&#xE921;"/>
            </Button>
            <Button x:Name="ExitButton" Style="{StaticResource CaptionButton}"
                    AutomationProperties.AutomationId="ExitButton" AutomationProperties.Name="退出"
                    ToolTipService.ToolTip="退出并恢复绑定窗口">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#C42B1C"/>
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/>
                </Button.Resources>
                <FontIcon FontSize="10" Glyph="&#xE8BB;"/>
            </Button>
        </StackPanel>
        <Border x:Name="PanelOutline" BorderThickness="1" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                IsHitTestVisible="False"/>
    </Grid>
</Window>
