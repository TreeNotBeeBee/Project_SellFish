<UserControl
    x:Class="WindowPilot.ImeToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="ImeSurfaceColor">#151411</Color>
                    <Color x:Key="ImeInkColor">#FFB74D</Color>
                    <Color x:Key="ImeHoverColor">#3D3222</Color>
                    <Color x:Key="KeyboardSurfaceColor">#000000</Color>
                    <Color x:Key="KeyboardInkColor">#FF8500</Color>
                    <Color x:Key="KeyboardHoverColor">#382000</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="ImeSurfaceColor">#FFF9EF</Color>
                    <Color x:Key="ImeInkColor">#854600</Color>
                    <Color x:Key="ImeHoverColor">#F4E6D2</Color>
                    <Color x:Key="KeyboardSurfaceColor">#FFFDF9</Color>
                    <Color x:Key="KeyboardInkColor">#914600</Color>
                    <Color x:Key="KeyboardHoverColor">#F8E7D2</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="ImeSurfaceColor" ResourceKey="SystemColorWindowColor"/>
                    <StaticResource x:Key="ImeInkColor" ResourceKey="SystemColorWindowTextColor"/>
                    <StaticResource x:Key="ImeHoverColor" ResourceKey="SystemColorButtonFaceColor"/>
                    <StaticResource x:Key="KeyboardSurfaceColor" ResourceKey="SystemColorWindowColor"/>
                    <StaticResource x:Key="KeyboardInkColor" ResourceKey="SystemColorWindowTextColor"/>
                    <StaticResource x:Key="KeyboardHoverColor" ResourceKey="SystemColorButtonFaceColor"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <SolidColorBrush x:Key="ImeSurfaceBrush" Color="{ThemeResource ImeSurfaceColor}"/>
            <SolidColorBrush x:Key="ImeInkBrush" Color="{ThemeResource ImeInkColor}"/>
            <SolidColorBrush x:Key="ImeHoverBrush" Color="{ThemeResource ImeHoverColor}"/>
            <SolidColorBrush x:Key="KeyboardSurfaceBrush" Color="{ThemeResource KeyboardSurfaceColor}"/>
            <SolidColorBrush x:Key="KeyboardInkBrush" Color="{ThemeResource KeyboardInkColor}"/>
            <SolidColorBrush x:Key="KeyboardHoverBrush" Color="{ThemeResource KeyboardHoverColor}"/>
            <StaticResource x:Key="ToggleButtonForegroundPointerOver" ResourceKey="ImeInkBrush"/>
            <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="ImeHoverBrush"/>
            <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="ImeInkBrush"/>
            <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="ImeInkBrush"/>
            <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="ImeInkBrush"/>
            <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="ImeSurfaceBrush"/>
            <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="ImeSurfaceBrush"/>
            <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="ImeSurfaceBrush"/>
            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="ImeHoverBrush"/>
            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="ImeInkBrush"/>
            <!-- 几何图标兼容较早的 Windows 10，每次展开模板都会得到独立的路径。 -->
            <DataTemplate x:Key="ImeHideIcon">
                <PathIcon Width="16" Height="16" Data="F1 M0.3,8 C2,5.05 4.85,3 8,3 C11.15,3 14,5.05 15.7,8 C14,10.95 11.15,13 8,13 C4.85,13 2,10.95 0.3,8 Z
                      M1.95,8 C3.6,10.2 5.65,11.6 8,11.6 C10.35,11.6 12.4,10.2 14.05,8 C12.4,5.8 10.35,4.4 8,4.4 C5.65,4.4 3.6,5.8 1.95,8 Z
                      M10.45,8 A2.45,2.45 0 1 1 5.55,8 A2.45,2.45 0 1 1 10.45,8 Z M1.5,2.4 L2.5,1.4 L14.5,13.4 L13.5,14.4 Z"/>
            </DataTemplate>
            <DataTemplate x:Key="ImeInvertIcon">
                <PathIcon Width="16" Height="16" Data="F0 M8,0.5 A7.5,7.5 0 1 1 8,15.5 A7.5,7.5 0 1 1 8,0.5 Z M8,2 A6,6 0 0 1 8,14 Z"/>
            </DataTemplate>
            <DataTemplate x:Key="ImeGrayIcon">
                <PathIcon Width="16" Height="16" Data="F0 M0.5,2 H15.5 V14 H0.5 Z M10.75,3.4 H14.1 V12.6 H10.75 Z
                      M6,3.4 H9.5 V4.65 H6 Z M6,6 H9.5 V7.25 H6 Z M6,8.7 H9.5 V10 H6 Z M6,11.35 H9.5 V12.6 H6 Z"/>
            </DataTemplate>
            <DataTemplate x:Key="ImeTopmostIcon"><FontIcon FontSize="16" Glyph="&#xE718;"/></DataTemplate>
            <DataTemplate x:Key="ImeThroughIcon"><FontIcon FontSize="16" Glyph="&#xE7C9;"/></DataTemplate>
            <!-- 三个图案对应固定位置。第三个图案里的输入板和话筒共用同一个点击区域。 -->
            <DataTemplate x:Key="KeyboardLanguage">
                <Grid Width="31" Height="22">
                    <PathIcon Width="14" Height="15" Data="F0 M6.3,0 H8 V2.5 H14 V10.8 H8 V15 H6.3 V10.8 H0 V2.5 H6.3 Z M1.6,4 V9.1 H6.3 V4 Z M8,4 V9.1 H12.4 V4 Z"/>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="KeyboardPunctuation">
                <Grid Width="21" Height="22">
                    <PathIcon Width="12" Height="13" Data="F0 M2.7,0 A2.7,2.7 0 1 1 2.69,0 Z M2.7,1.4 A1.3,1.3 0 1 1 2.69,1.4 Z
                        M9.6,6.6 C11.2,6.6 12,7.7 12,9.1 C12,10.7 11.1,11.9 9.2,13 L8.7,12.2 C9.4,11.7 10,11.1 10.1,10.8 C8.4,10.9 7.5,10.2 7.5,8.7 C7.5,7.4 8.5,6.6 9.6,6.6 Z"/>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="KeyboardInput">
                <Grid Width="54" Height="22">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                        <PathIcon Width="16" Height="14" Data="F0 M0.5,0 H12 V2 H13.3 C16.8,2 17.1,7.8 13.1,8 H12 V11.8 H0.5 Z
                            M2,1.5 V10.3 H10.5 V1.5 Z M12,3.6 V6.4 H13 C14.8,6.4 14.9,3.6 13,3.6 Z M0,12.8 H12 V14 H0 Z"/>
                        <PathIcon Width="15" Height="15" Data="F0 M7.5,0 C10,0 11.7,1.7 11.7,4 V7.1 C11.7,9.5 10,11.1 7.5,11.1 C5,11.1 3.3,9.5 3.3,7.1 V4 C3.3,1.7 5,0 7.5,0 Z
                            M7.5,1.4 C5.9,1.4 4.9,2.5 4.9,4 V7.1 C4.9,8.7 5.9,9.7 7.5,9.7 C9.1,9.7 10.1,8.7 10.1,7.1 V4 C10.1,2.5 9.1,1.4 7.5,1.4 Z
                            M0,7 H1.5 C1.7,10.7 3.8,13.2 7.5,13.2 C11.2,13.2 13.3,10.7 13.5,7 H15 C14.8,11.7 12.1,14.8 7.5,14.8 C2.9,14.8 0.2,11.7 0,7 Z"/>
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="KeyboardExpand">
                <PathIcon Width="14" Height="14" Data="F0 M0,0 H6 V6 H0 Z M1.4,1.4 V4.6 H4.6 V1.4 Z M8,0 H14 V6 H8 Z M9.4,1.4 V4.6 H12.6 V1.4 Z
                    M0,8 H6 V14 H0 Z M1.4,9.4 V12.6 H4.6 V9.4 Z M8,8 H14 V14 H8 Z M9.4,9.4 V12.6 H12.6 V9.4 Z"/>
            </DataTemplate>
            <DataTemplate x:Key="InitialExpand"><FontIcon FontSize="14" Glyph="&#xE922;"/></DataTemplate>
            <Style x:Key="ImeToggle" TargetType="ToggleButton">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{ThemeResource ImeInkBrush}"/>
            </Style>
            <Style x:Key="KeyboardToggle" TargetType="ToggleButton" BasedOn="{StaticResource ImeToggle}">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="Foreground" Value="{ThemeResource KeyboardInkBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Highlight.Opacity" Value="1"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Highlight.Opacity" Value="1"/>
                                                <Setter Target="Glyph.Opacity" Value=".7"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Glyph.Opacity" Value=".55"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="ActiveMark.Opacity" Value="1"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="ActiveMark.Opacity" Value="1"/>
                                                <Setter Target="Highlight.Opacity" Value="1"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="ActiveMark.Opacity" Value="1"/>
                                                <Setter Target="Glyph.Opacity" Value=".7"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedDisabled">
                                            <VisualState.Setters>
                                                <Setter Target="ActiveMark.Opacity" Value=".55"/>
                                                <Setter Target="Glyph.Opacity" Value=".55"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="Highlight" CornerRadius="2" Opacity="0" Background="{ThemeResource KeyboardHoverBrush}"/>
                                <ContentPresenter x:Name="Glyph" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                                <Border x:Name="ActiveMark" Width="9" Height="1" Opacity="0" VerticalAlignment="Bottom" Background="{TemplateBinding Foreground}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel x:Name="Strip" Orientation="Horizontal" Background="{ThemeResource ImeSurfaceBrush}" Padding="3,2" Spacing="1">
        <Grid x:Name="DragGrip" x:FieldModifier="internal" Width="28" Height="24" Background="Transparent"
              ToolTipService.ToolTip="拖动工具栏">
            <Image x:Name="Logo" Width="21" Height="21" Stretch="Uniform" Source="ms-appx:///Assets/FishBasket.png"
                   AutomationProperties.HelpText="初始图标"
                   AutomationProperties.AutomationId="Mini.DragHandle" AutomationProperties.Name="sell fish，拖动工具栏"/>
        </Grid>
        <StackPanel x:Name="Actions" x:FieldModifier="internal" Orientation="Horizontal" Spacing="1"
                    AutomationProperties.AutomationId="ImeActionSlots"/>
        <Button x:Name="Expand" x:FieldModifier="internal" Width="28" Height="24" MinWidth="0" MinHeight="0" Padding="0"
                CornerRadius="4" BorderThickness="0" Background="Transparent" Foreground="{ThemeResource ImeInkBrush}"
                AutomationProperties.AutomationId="ImeExpandButton" AutomationProperties.Name="展开主面板"
                ToolTipService.ToolTip="展开主面板">
            <FontIcon FontSize="14" Glyph="&#xE922;"/>
        </Button>
    </StackPanel>
</UserControl>
